# Nothing is needed here for the normal setup: the "Deploy backend" GitHub workflow deploys to Neon,
# and Neon gives the server its settings (DATABASE_URL, NEON_AUTH_JWKS_URL) by itself.
#
# Only for running the server somewhere else by hand (npm start). Copy to .env, which git ignores.
# Neon console → your project → Connect → "Pooled connection":
DATABASE_URL=
# Neon console → Auth → Configuration → JWKS URL:
NEON_AUTH_JWKS_URL=
PORT=8787
