{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "api", "test"],
  // Uses the desktop app's path aliases; Vitest runs it, this type-check doesn't.
  "exclude": ["test/app-client.test.ts"]
}
