# Vanity voice server settings. Copy this file to .env (next to it) and fill it in.
# .env is ignored by git: secrets in it never end up in the repository.

# The port to listen on. Hosts like Render, Railway and Fly set PORT themselves.
PORT=8787

# Your Vanity account server (the same address the app uses). The voice server asks it who each
# player is, so rooms show real Vanity names and pictures and nobody can pretend to be someone else.
# This is a public address, not a secret.
VANITY_API_URL=https://br-damp-pine-bdkamz55-vanity.compute.c-8.us-east-2.aws.neon.tech

# Let people in without an account, by a name they type. Only for trying the server out on your own.
ALLOW_GUESTS=false

# STUN servers (comma-separated). Leave this line out for the built-in public ones (Google, Cloudflare).
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478

# ---- TURN: needed for players on strict networks (some home routers, mobile data, offices, schools) ----
# Without TURN, two such players may hear nothing. Fill in ONE of the two login styles below.
#
# Your TURN server's addresses (comma-separated). Include a TCP or TLS one for networks that block UDP.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
#
# Style 1 (recommended): a shared secret, as coturn's "use-auth-secret" / "static-auth-secret" uses.
# Each player gets their own login that runs out after TURN_TTL_SECONDS; the secret stays here.
# TURN_SECRET=
# TURN_TTL_SECONDS=21600
#
# Style 2: one fixed username and password (what some hosted TURN services give you).
# Every player gets the same login, so only use a TURN account you don't mind players seeing.
# TURN_USERNAME=
# TURN_CREDENTIAL=
