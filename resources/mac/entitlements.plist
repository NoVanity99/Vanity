<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the Mac app is allowed to do under Apple's hardened runtime (needed for notarization).
     - JIT and unsigned executable memory: Electron's JavaScript engine needs them.
     - disable-library-validation: lets the app load its own native parts (the database, the
       push-to-talk key listener) when it is ad-hoc signed rather than signed with a Developer ID.
     - audio-input / camera: voice chat and video in voice rooms (macOS also asks the user). -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.device.camera</key>
  <true/>
</dict>
</plist>
