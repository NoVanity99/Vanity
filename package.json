{
  "name": "vanity",
  "productName": "Vanity",
  "version": "0.2.0",
  "description": "A unified desktop game launcher for Steam, Epic, GOG, EA, Ubisoft and custom games.",
  "main": "./out/main/index.js",
  "license": "MIT",
  "private": true,
  "vanity": {
    "repo": "NoVanity99/Vanity",
    "updateBranch": "claude/happy-cori-k2ntxm"
  },
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "start": "install-electron && electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "preview": "install-electron && electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist:win": "install-electron && npm run build && electron-builder --win",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup-keys": "node scripts/setup-keys.mjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/exo-2": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/orbitron": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "lucide-react": "1.55.0",
    "music-metadata": "11.16.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}
