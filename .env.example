# Copy this file to .env.local and fill in your keys. .env.local is ignored by
# git, so the keys never reach GitHub. They are built into the app at build time
# and used whenever the matching field in Settings is left empty.
MAIN_VITE_STEAMGRIDDB_API_KEY=
MAIN_VITE_IGDB_CLIENT_ID=
MAIN_VITE_IGDB_CLIENT_SECRET=
# Your Vanity account server (see server/README.md), e.g. https://your-project.vercel.app
MAIN_VITE_VANITY_API_URL=
