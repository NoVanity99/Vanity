# Copy this file to .env.local to override things in a development build.
# .env.local is ignored by git. NEVER put a secret that must stay secret in here or anywhere in
# the app: everything below is built into the program and can be read by anyone who has it.
#
# The Steam Web API key does NOT go here. It lives on the server only (see server/README.md).

# Artwork and metadata keys. Built-in ones are used when these are empty.
MAIN_VITE_STEAMGRIDDB_API_KEY=
MAIN_VITE_IGDB_CLIENT_ID=
MAIN_VITE_IGDB_CLIENT_SECRET=

# Accounts: use another backend than the built-in one (src/shared/backend.ts), e.g. the local
# stand-in from server/test/support/local-stack.ts. Both are public addresses, not secrets.
MAIN_VITE_NEON_AUTH_URL=
MAIN_VITE_VANITY_BACKEND_URL=

# Only for copies run from source: the Vercel server that hands out updates.
MAIN_VITE_VANITY_API_URL=
